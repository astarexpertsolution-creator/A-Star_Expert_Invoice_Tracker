rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() { return request.auth != null; }
    function isAdmin() { return isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)); }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }

    // --- Entity Validations ---
    function isValidSupplier(data) {
      return data.keys().hasAll(['name', 'code', 'status']) &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 200 &&
             data.code is string && data.code.size() > 0 && data.code.size() <= 50;
    }

    function isValidProduct(data) {
      return data.keys().hasAll(['name', 'sku', 'category', 'unitPrice', 'taxPercentage', 'status']) &&
             data.name is string && data.name.size() > 0 &&
             data.unitPrice is number && data.unitPrice >= 0 &&
             data.taxPercentage is number && data.taxPercentage >= 0;
    }

    function isValidLead(data) {
      return data.keys().hasAll(['companyName', 'contactPerson', 'status', 'createdAt']) &&
             data.status in ['Lead', 'Appointment', 'Onboarded'];
    }

    function isValidCustomer(data) {
      return data.keys().hasAll(['name', 'code', 'status']) &&
             data.name is string && data.code is string;
    }

    function isValidPO(data) {
      return data.keys().hasAll(['poNumber', 'customerId', 'poDate', 'status']) &&
             data.poNumber is string && data.customerId is string;
    }

    function isValidInvoice(data) {
      return data.keys().hasAll(['invoiceNumber', 'customerId', 'grandTotal', 'status', 'createdAt']) &&
             data.grandTotal is number && data.grandTotal >= 0;
    }

    // --- Matches ---
    match /suppliers/{supplierId} {
      allow list, get: if isSignedIn();
      allow create: if isSignedIn() && isValidSupplier(incoming());
      allow update: if isSignedIn() && isValidSupplier(incoming());
      allow delete: if isAdmin();
    }

    match /products/{productId} {
      allow list, get: if isSignedIn();
      allow create: if isSignedIn() && isValidProduct(incoming());
      allow update: if isSignedIn() && isValidProduct(incoming());
      allow delete: if isAdmin();
    }

    match /leads/{leadId} {
      allow list: if isSignedIn();
      allow get: if isSignedIn(); // Add ownership check if necessary
      allow create: if isSignedIn() && isValidLead(incoming());
      allow update: if isSignedIn() && isValidLead(incoming());
      allow delete: if isAdmin();
    }

    match /customers/{customerId} {
      allow list, get: if isSignedIn();
      allow create: if isSignedIn() && isValidCustomer(incoming());
      allow update: if isSignedIn() && isValidCustomer(incoming());
      allow delete: if isAdmin();
    }

    match /purchaseOrders/{poId} {
      allow list, get: if isSignedIn();
      allow create: if isSignedIn() && isValidPO(incoming());
      allow update: if isSignedIn() && (
        (incoming().diff(existing()).affectedKeys().hasOnly(['status'])) ||
        isValidPO(incoming())
      );
      allow delete: if isAdmin();
    }

    match /invoices/{invoiceId} {
      allow list, get: if isSignedIn();
      allow create: if isSignedIn() && isValidInvoice(incoming());
      allow update: if isSignedIn() && (
        (incoming().diff(existing()).affectedKeys().hasOnly(['status', 'dispatchStatus', 'paidAmount'])) ||
        isValidInvoice(incoming())
      );
      allow delete: if isAdmin();
    }
    
    match /admins/{userId} {
      allow read: if isSignedIn();
    }
  }
}
