rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net (TEMPORARY: Allow all for debugging)
    match /{document=**} {
      allow read, write: if true;
    }

    // --- Helpers ---
    function isSignedIn() { return request.auth != null; }
    function isAdmin() { return isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)); }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }

    // --- Entity Validations ---
    function isValidSupplier(data) {
      return data.keys().hasAll(['name', 'code', 'status']) &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 200 &&
             data.code is string && data.code.size() > 0 && data.code.size() <= 50;
    }

    function isValidProduct(data) {
      return data.keys().hasAll(['name', 'sku', 'category', 'unitPrice', 'taxPercentage', 'status']) &&
             data.name is string && data.name.size() > 0 &&
             data.unitPrice is number && data.unitPrice >= 0 &&
             data.taxPercentage is number && data.taxPercentage >= 0;
    }

    function isValidLead(data) {
      return data.keys().hasAll(['companyName', 'status', 'createdAt']) &&
             data.companyName is string && data.companyName.size() > 0 &&
             data.status in [
               'Draft', 'New Lead Created', 'Yet to meet', 'Appointment scheduled', 
               'Meeting completed', 'Received Enquiry', 'Shared Quotation', 
               'Negotiation', 'PO Received', 'Converted', 'On Hold', 'Lost', 'Rescheduled'
             ];
    }

    function isValidCustomer(data) {
      return data.keys().hasAll(['name', 'status', 'createdAt']) &&
             data.name is string && data.name.size() > 0;
    }

    function isValidPO(data) {
      return data.keys().hasAll(['poNumber', 'customerId', 'status']) &&
             data.poNumber is string && data.customerId is string;
    }

    function isValidInvoice(data) {
      return data.keys().hasAll(['invoiceNumber', 'customerId', 'grandTotal', 'status', 'createdAt']) &&
             data.invoiceNumber is string && data.grandTotal is number;
    }

    function isValidTracker(data) {
      return data.keys().hasAll(['type', 'title', 'status', 'createdAt']) &&
             data.type is string && data.title is string;
    }

    // --- Matches ---
    match /suppliers/{supplierId} {
      allow list, get: if isSignedIn();
      allow create, update: if isSignedIn();
      allow delete: if isAdmin();
    }

    match /products/{productId} {
      allow list, get: if isSignedIn();
      allow create, update: if isSignedIn();
      allow delete: if isAdmin();
    }

    match /leads/{leadId} {
      allow list, get: if isSignedIn();
      allow create: if isSignedIn() && isValidLead(incoming());
      allow update: if isSignedIn() && (isValidLead(incoming()) || isAdmin());
      allow delete: if isAdmin();
    }

    match /customers/{customerId} {
      allow list, get: if isSignedIn();
      allow create: if isSignedIn() && isValidCustomer(incoming());
      allow update: if isSignedIn() && (isValidCustomer(incoming()) || isAdmin());
      allow delete: if isAdmin();
    }

    match /purchaseOrders/{poId} {
      allow list, get: if isSignedIn();
      allow create, update: if isSignedIn();
      allow delete: if isAdmin();
    }

    match /invoices/{invoiceId} {
      allow list, get: if isSignedIn();
      allow create, update: if isSignedIn();
      allow delete: if isAdmin();
    }

    match /tracker/{itemId} {
      allow list, get: if isSignedIn();
      allow create, update: if isSignedIn() && isValidTracker(incoming());
      allow delete: if isAdmin();
    }
    
    match /admins/{userId} {
      allow read: if isSignedIn();
    }
  }
}
